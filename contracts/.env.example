# JetrPay Contracts Environment Variables

# ============================================
# RANGE PROTOCOL API (Compliance Screening)
# ============================================
# Get your API key at https://app.range.org/
# Free API credits for Solana Privacy Hackathon participants!
# Docs: https://docs.range.org/risk-api/risk-introduction
RANGE_API_KEY=your_range_api_key_here

# ============================================
# HELIUS RPC (Enhanced Solana Infrastructure)
# ============================================
# Get your RPC URL at https://helius.dev/
HELIUS_RPC_URL=https://devnet.helius-rpc.com/?api-key=your_helius_key_here

# ============================================
# SOLANA NETWORK
# ============================================
# Options: devnet, mainnet-beta, testnet
SOLANA_NETWORK=devnet
